{
  "manifest_version": 3,
  "name": "GC Steam Hours",
  "version": "1.1.0",
  "description": "Mostra horas de CS2 na Steam nos lobbies e perfis da GamersClub",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.steampowered.com/*",
    "https://gamersclub.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gamersclub.com.br/lobby*",
        "https://gamersclub.com.br/jogador/*",
        "https://gamersclub.com.br/player/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
